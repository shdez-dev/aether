# Copia este archivo a infra/.env.brevo. Nunca subas el archivo real a Git.
# Brevo > Configuración > SMTP y API > pestaña SMTP (NO la clave API).
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# El remitente debe estar dado de alta/verificado en Brevo.
# Una cuenta Gmail sirve para pruebas, pero no permite autenticar el dominio.
AETHER_SMTP_FROM=aether.notifications@gmail.com

# Credenciales del administrador del Keycloak local de infra/compose.yaml.
AETHER_KEYCLOAK_ADMIN_USERNAME=admin
AETHER_KEYCLOAK_ADMIN_PASSWORD=aether_local_only
