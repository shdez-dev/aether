[Unit]
Description=Deploy the latest AETHER main branch on Raspberry Pi
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=athe
Group=athe
WorkingDirectory=/home/athe/aether
ExecStart=/usr/bin/bash /home/athe/aether/infra/deploy/update.sh
Nice=10
IOSchedulingClass=idle
