{
  "name": "aether",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aether institutional initiative and project governance platform",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.24.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc --noEmit --project tsconfig.json",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "architecture:check": "node scripts/check-architecture.mjs",
    "openapi:validate": "node scripts/validate-openapi.mjs",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm architecture:check && pnpm openapi:validate && pnpm test && pnpm build",
    "db:migrate": "pnpm --filter @aether/database migrate",
    "local:up": "docker compose -f infra/compose.yaml up -d",
    "local:down": "docker compose -f infra/compose.yaml down",
    "local:email:brevo": "node scripts/configure-keycloak-brevo.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0",
    "yaml": "2.9.0"
  }
}
