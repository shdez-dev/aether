# Worker local: copia a .env y conserva los secretos fuera de Git.
DATABASE_URL=postgresql://aether:aether_local_only@localhost:5433/aether
WORKER_ID=aether-local-worker
OUTBOX_POLL_INTERVAL_MS=1000
OTEL_EXPORTER_OTLP_ENDPOINT=
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=aether-local
S3_ACCESS_KEY_ID=aether-local
S3_SECRET_ACCESS_KEY=aether_local_only_minio_secret
MAX_DOCUMENT_BYTES=10485760
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
