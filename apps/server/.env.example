# Valores de desarrollo. Nunca añadas secretos reales a este archivo.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://aether:aether_local_only@localhost:5433/aether
REDIS_URL=redis://localhost:6379
SERVER_PUBLIC_URL=http://127.0.0.1:4000
WEB_ORIGIN=http://127.0.0.1:3000
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/aether-local
OIDC_CLIENT_ID=aether-local
OIDC_CLIENT_SECRET=aether_local_only_client_secret
OIDC_REDIRECT_URI=http://127.0.0.1:4000/auth/callback
# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Debe ser único por entorno y nunca versionarse como valor real.
SESSION_ENCRYPTION_KEY=<BASE64_32_BYTE_KEY>
SESSION_TTL_SECONDS=28800
SESSION_RENEWAL_WINDOW_SECONDS=1800
# Límite de cuerpo, abuso de API y nivel de logs para desarrollo local.
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=info
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=aether-local
S3_ACCESS_KEY_ID=aether-local
S3_SECRET_ACCESS_KEY=aether_local_only_minio_secret
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_TOKEN=aether_local_only_metrics_token_32_chars
